# wg-ui environment — copy to /etc/wg-ui/wg-ui.env on the server and fill in.
# Loaded by the systemd unit (EnvironmentFile=); wg-admin.py also reads the
# WGUI_SERVER_PUB / WGUI_ENDPOINT / WGUI_CLIENT_* / WGUI_IFACE values from this
# file directly (sudo strips the environment). NEVER commit the real file.
# chmod 640, owner root:wgui.

# ── required: auth ────────────────────────────────────────────────────────
WGUI_USER=admin

# Password hash — PBKDF2-HMAC-SHA256, format "iterations$hexdigest". Generate:
#   SALT=$(openssl rand -hex 16)
#   python3 -c 'import hashlib,getpass,sys; \
#     print("200000$"+hashlib.pbkdf2_hmac("sha256",getpass.getpass().encode(),sys.argv[1].encode(),200000).hex())' "$SALT"
# then put SALT below and the output in WGUI_PASS_PBKDF2.
WGUI_SALT=replace-with-openssl-rand-hex-16
WGUI_PASS_PBKDF2=replace-with-200000$pbkdf2-hex

# Legacy scheme — single SHA-256(SALT+password). Only used when WGUI_PASS_PBKDF2
# is not set; kept so old env files keep working. Prefer PBKDF2 above.
# WGUI_PASS_SHA256=

# Session-cookie signing key (HMAC). Required, min 24 chars — the service
# refuses to start with a missing or placeholder value:
#   openssl rand -hex 32
WGUI_SESSION_SECRET=replace-with-openssl-rand-hex-32

# ── optional: paths & tuning (defaults shown, uncomment to override) ──────
# WGUI_PORT=443
# WGUI_CERT=/etc/wg-ui/cert.pem
# WGUI_KEY=/etc/wg-ui/key.pem
# WGUI_CLIENTS=/etc/wg-ui/clients.json
# WGUI_IFACE=wg-cl                 # entry tunnel (device -> VDSina); also used by wg-admin.py
# WGUI_DO_IFACE=wg-do              # cascade tunnel (VDSina -> NL exit)
# WGUI_US_IFACE=wg-us              # cascade tunnel (VDSina -> US exit); optional until dual-exit is enabled
# WGUI_AWG_IFACES=wg-do wg-us      # space-separated ifaces running AmneziaWG (read via `awg show`; needs sudoers entry)
# WGUI_EXIT_IP=198.51.100.10      # expected NL cascade egress IP (health check); empty = any IP via wg-do counts as ok
# WGUI_US_EXIT_IP=198.51.100.20    # expected US cascade egress IP (health check); empty = any IP via wg-us counts as ok
# WGUI_SRC_IP=10.10.0.1            # source IP for the NL egress probe
# WGUI_ONLINE_SECS=180             # peer considered online if handshake < this
# WGUI_SESSION_TTL=604800          # login session lifetime (7 days)
# WGUI_SAMPLE_SECS=5               # throughput sampler interval
# WGUI_MAX_CONN=64                 # max concurrent connection handler threads
# WGUI_DB=/var/lib/wg-ui/history.db
# WGUI_GEN=/var/lib/wg-ui/session.gen   # session-generation file ("log out everywhere")
# WGUI_SPLIT_STATE=/etc/wg-ui/split-server.state
# WGUI_AUDIT=/var/log/wg-ui/audit.log   # written by the root helper; dir is root:wgui 0750

# ── optional: values baked into generated client configs (wg-admin.py) ────
# REQUIRED for add/getconf/regenerate — helper refuses to run without them:
# WGUI_SERVER_PUB=…base64…=          # wg-cl server public key
# WGUI_ENDPOINT=203.0.113.10:51820    # public endpoint clients dial
# WGUI_CLIENT_DNS=1.1.1.1
# WGUI_CLIENT_MTU=1420
# REQUIRED for split-server (RU-direct) — WAN iface on the entry node:
# WGUI_WAN_IFACE=ens3
