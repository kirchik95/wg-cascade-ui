# wg-ui environment — copy to /etc/wg-ui/wg-ui.env on the server and fill in.
# Loaded by the systemd unit (EnvironmentFile=). NEVER commit the real file.
# chmod 640, owner root:wgui.

# ── required: auth ────────────────────────────────────────────────────────
WGUI_USER=admin

# Password is never stored in plaintext — only as SHA-256(SALT + password).
# Generate:
#   SALT=$(openssl rand -hex 16)
#   printf '%s' "${SALT}your-password" | sha256sum
# then put SALT below and the hash in WGUI_PASS_SHA256.
WGUI_SALT=replace-with-openssl-rand-hex-16
WGUI_PASS_SHA256=replace-with-sha256-of-salt-plus-password

# Session-cookie signing key (HMAC). Any long random string:
#   openssl rand -hex 32
WGUI_SESSION_SECRET=replace-with-openssl-rand-hex-32

# ── optional: paths & tuning (defaults shown, uncomment to override) ──────
# WGUI_PORT=443
# WGUI_CERT=/etc/wg-ui/cert.pem
# WGUI_KEY=/etc/wg-ui/key.pem
# WGUI_CLIENTS=/etc/wg-ui/clients.json
# WGUI_IFACE=wg-cl                 # entry tunnel (device -> VDSina)
# WGUI_DO_IFACE=wg-do              # cascade tunnel (VDSina -> DO exit)
# WGUI_EXIT_IP=198.51.100.10      # expected cascade egress IP (health check)
# WGUI_SRC_IP=10.10.0.1            # source IP for the egress probe
# WGUI_ONLINE_SECS=180             # peer considered online if handshake < this
# WGUI_SESSION_TTL=604800          # login session lifetime (7 days)
# WGUI_SAMPLE_SECS=5               # throughput sampler interval
# WGUI_DB=/var/lib/wg-ui/history.db
# WGUI_SPLIT_STATE=/etc/wg-ui/split-server.state
# WGUI_AUDIT=/var/lib/wg-ui/audit.log
