[Unit]
Description=WireGuard cascade status UI + manager (HTTPS)
After=network-online.target wg-quick@wg-cl.service
Wants=network-online.target

[Service]
Type=simple
User=wgui
Group=wgui
EnvironmentFile=/etc/wg-ui/wg-ui.env
ExecStart=/usr/bin/python3 /opt/wg-ui/wg-ui.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=false
# admin helper (run as root via sudo) must write the cascade config + state here:
ReadWritePaths=/etc/wireguard /etc/wg-ui

[Install]
WantedBy=multi-user.target
