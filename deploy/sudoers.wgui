# /etc/sudoers.d/wg-ui — installed by deploy.sh (after `visudo -cf`), mode 0440.
# The web service runs as `wgui` and may only read the tunnel dumps and invoke
# the root helper. Exact commands only — never widen to `wg *` / `awg *`.
# Exit tunnels may run plain WireGuard (wg) or AmneziaWG (awg); see docs/TUNNELS.md.
Cmnd_Alias WGUI_DUMP = /usr/bin/wg show wg-cl dump, \
                       /usr/bin/wg show wg-do dump, \
                       /usr/bin/wg show wg-us dump, \
                       /usr/bin/awg show wg-do dump, \
                       /usr/bin/awg show wg-us dump
Cmnd_Alias WGUI_ADMIN = /usr/bin/python3 /opt/wg-ui/wg-admin.py *
# The dumps run ~36×/min and are read-only: logging each one (3 journal lines)
# drowned the journal (~140k lines/day) and evicted real history. Mutations via
# the helper keep full sudo logging and write their own audit log.
Defaults!WGUI_DUMP !log_allowed, !pam_session
wgui ALL=(root) NOPASSWD: WGUI_DUMP, WGUI_ADMIN
